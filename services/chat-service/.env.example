GRPC_PORT=:50051
OTEL_EXPORTER_OTLP_ENDPOINT=tempo:4317
# Pause before each echoed word, in milliseconds. 0 disables the delay.
ECHO_DELAY_MS=60
# Responder backing the Chat RPC: echo | llm. An unrecognised value is a
# startup error, not a fallback. echo needs no model, so load tests and CI stay
# zero-cost.
RESPONDER=echo
# Any OpenAI-compatible provider: OpenAI below, or the local Ollama block
# further down. A credential embedded in the URL is a startup error; it would
# be logged and shown to the browser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Sent as an Authorization: Bearer header. Locally, a key from a dev-only
# OpenAI project with its own monthly budget; production uses a separate
# project and key, from a Secret. Never commit a real key.
LLM_API_KEY=
# Embedding provider. ollama | openai — both speak the OpenAI-compatible
# /embeddings API, so this only names which defaults apply. Unknown is a
# startup error.
EMBEDDER=openai
# Independent of LLM_*. Credentials embedded in the URL are a startup error.
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
# May be the same dev key as LLM_API_KEY.
EMBED_API_KEY=
# Free offline alternative: `docker compose --profile llm --profile ollama up`
# with these values instead, keys empty, and re-ingest with --profile ollama.
# NOTE: both models are duplicated in docker-compose.yml, where the ollama
# service pulls them and healthchecks on them. Change both together.
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=llama3.2:3b
#   EMBEDDER=ollama
#   EMBED_BASE_URL=http://ollama:11434/v1
#   EMBED_MODEL=nomic-embed-text
#   RETRIEVAL_MIN_SCORE=0.5
# Vector store. The collection name is derived from the embedding model and its
# dimension, never configured: a free-form name is one typo away from searching
# a space another model wrote.
QDRANT_URL=http://qdrant:6333
# Passages per turn, and the honesty floor beneath which nothing is passed to
# the model. Tune MIN_SCORE from chat_retrieval_top_score in Grafana; each
# embedding model scores on its own scale, so it changes with EMBED_MODEL.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.5
# Slots of TOP_K reserved for the background. "Who are you?" has no semantic
# anchor and would otherwise retrieve arbitrarily.
RETRIEVAL_BACKGROUND_FLOOR=2
# Prompt-injection classifier (the guard compose service). llm mode refuses to
# start until it answers; a per-turn failure withholds the turn, counted in
# chat_guard_checks_total{verdict="error"}.
GUARD_URL=http://guard
# Turns whose worst window scores at or above this get a fixed refusal. Tune it
# from chat_guard_score in Grafana. Strictly between 0 and 1.
GUARD_THRESHOLD=0.5
# HMAC key for reply signatures, 64 hex characters (openssl rand -hex 32).
# Empty draws a per-process key: fine for one instance, but replicas behind a
# load balancer must share one or history is silently dropped. Never commit it.
HISTORY_KEY=
# Abuse and cost limits. Each is required: a missing, zero or unparsable value
# is a startup error, never "unlimited". Days are UTC; a restart resets budgets.
# Tokens a visitor may spend per day, condense and reply, input and output.
BUDGET_TOKENS_PER_VISITOR=20000
# Site-wide tokens per day. Turns already in flight finish past it, so set the
# provider's spend cap above this plus MAX_STREAMS_GLOBAL x ~20k tokens.
# NOTE: infra/prometheus/rules/chat.yml alerts at 70% of this. Change both together.
BUDGET_TOKENS_GLOBAL=500000
# Distinct visitors per day; past it new visitors are refused, bounding memory.
BUDGET_MAX_VISITORS=100000
# Output ceiling per reply; input is bounded by the history limit instead.
MAX_OUTPUT_TOKENS=800
# Concurrent streams. Over the cap is refused at once, never queued.
MAX_STREAMS_GLOBAL=16
MAX_STREAMS_PER_VISITOR=2
# Longest a turn may hold its stream slot. Above a hosted provider's slow tail
# and a cold Ollama model load (~33s).
# NOTE: Envoy's max_stream_duration on the chat route must stay above this.
CHAT_TURN_TIMEOUT_SECONDS=120
